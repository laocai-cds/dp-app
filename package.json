{
  "name": "dp-gqtthc",
  "version": "1.1.62",
  "description": "Đồng bộ đảng phí gqtthc",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "keywords": [],
  "author": "laocai-cds",
  "license": "ISC",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "productName": "DP-DangPhi",
  "repository": {
    "type": "git",
    "url": "https://github.com/laocai-cds/dp-app.git"
  },
  "build": {
    "appId": "vn.laocai.dpdangphi",
    "productName": "DP-DangPhi",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-pop.js",
      "toolbar.html",
      "xapop.html",
      "huong-dan.html",
      "bm/**",
      "config.json",
      "package.json",
      "build/icon.png"
    ],
    "extraFiles": [
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "HUONG-DAN.txt",
        "to": "HUONG-DAN.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DP-DangPhi-Setup.exe",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}